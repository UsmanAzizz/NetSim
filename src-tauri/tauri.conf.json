{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "netsim",
  "version": "0.1.0",
  "identifier": "com.netsim.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NetSim",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDNDQ0EyOTU0MDFBN0IKUldSN0drQ1Zvc3dEMjdZYkhETGxHc1NhS1VkL2l1YzcyUzhuU2hCcDc5U2VIU3o2biswVnVrcFAK",
      "endpoints": [
        "https://github.com/UsmanAzizz/NetSim/releases/latest/download/latest.json"
      ]
    }
  }
}
